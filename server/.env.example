# ===== 数据库（SSH 隧道直连，本地回环）=====
# MySQL 8.4：先跑 sql/init.sql 初始化
MYSQL_DSN=root:你的密码@tcp(127.0.0.1:3306)/home_items?charset=utf8mb4&parseTime=true&loc=Local

# Redis 7（隧道映射，服务器已设 requirepass）
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=你的Redis密码
REDIS_DB=0

# ===== JWT =====
# HS256 密钥，至少 32 字节随机串；两个服务必须相同（token 互通）
# 生成方式：openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-secret-at-least-32-bytes
JWT_ISSUER=home-items
JWT_AUDIENCE=web
# access token 有效期（设计稿：15 分钟）
ACCESS_TTL=15m
# refresh token 有效期（设计稿：7 天）
REFRESH_TTL=168h

# ===== Cookie =====
# 本地 http 开发设 false；生产 HTTPS 必须 true
COOKIE_SECURE=false

# ===== 服务 =====
PORT=8080
# 图片上传目录（相对 server 工作目录）与大小上限（MB）
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5

# ===== 权限码 Redis 缓存时长 =====
PERM_CACHE_TTL=30m

# 孤儿图片宽限期：无引用且上传超过该时长的文件由定时任务清理
#UPLOAD_GRACE=24h
